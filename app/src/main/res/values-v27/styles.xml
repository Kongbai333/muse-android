<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Navigation-bar icon appearance is supported starting with Android 8.1. -->
    <style name="MuseTheme" parent="MuseBaseTheme">
        <item name="android:windowLightNavigationBar">@bool/muse_light_bars</item>
    </style>
    <style name="MuseSheet" parent="MuseBaseSheet">
        <item name="android:windowLightNavigationBar">@bool/muse_light_bars</item>
    </style>
    <style name="MuseLaunch" parent="MuseTheme">
        <item name="android:windowBackground">@drawable/launch_window</item>
        <item name="android:statusBarColor">@color/muse_launch_bg</item>
        <item name="android:navigationBarColor">@color/muse_launch_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
